# numbers: everyday number-theory words for hunting, written in Trawl itself.
#   use numbers
#
# These words keep their working values on the seabed at -65535 .. -65280.
# Leave those cells alone in your own programs and the library will never step on you.
#
#   isqrt    ( n -- r )        floor of the square root of n (n >= 0)
#   vp       ( n p -- e )      how many times p divides n (0 for n = 0)
#   legendre ( n p -- e )      how many times the prime p divides n!
#   carries  ( a b p -- c )    carries when adding a + b in base p
#                              (Kummer: the power of p in the binomial C(a+b, a))
#   powmod   ( b e m -- r )    b to the power e, mod m (e >= 0, m >= 1)
#   ndigits  ( x base -- k )   how many digits x has in that base (0 has 1)
#   reverse  ( x base -- y )   the digits of x in that base, read backwards
#   smooth   ( n B -- flag )   1 if every prime factor of n is at most B
#   nextprime ( n -- p )       the smallest prime above n
#   totient  ( n -- phi )      how many of 1..n share no factor with n (n >= 1)
#   sigma    ( n -- s )        the sum of the divisors of n (n >= 1)
#   ndivisors ( n -- d )       how many divisors n has (n >= 1)
#   mobius   ( n -- m )        0 if a square above 1 divides n, else 1 or -1 for an even
#                              or odd number of prime factors (n >= 1)

use stdlib

: isqrt dup 2 < if else
    dup
    over over / over + 2 /
    over over > [ drop nip
      over over / over + 2 /
      over over > ] drop drop nip
  then ;

: vp -65535 bury -65534 bury 0 -65533 bury
  -65534 dig 0 = 0 = if
    -65534 dig -65535 dig % 0 = [ drop
      -65534 dig -65535 dig / -65534 bury
      -65533 dig 1 + -65533 bury
      -65534 dig -65535 dig % 0 = ] drop
  then
  -65533 dig ;

: legendre -65535 bury -65534 bury 0 -65533 bury
  -65534 dig -65535 dig / -65534 bury
  -65534 dig 0 > [ drop
    -65533 dig -65534 dig + -65533 bury
    -65534 dig -65535 dig / -65534 bury
    -65534 dig 0 > ] drop
  -65533 dig ;

# digit sums do the work: carries = (s(a) + s(b) - s(a+b)) / (p - 1)
: carries -65535 bury -65534 bury -65533 bury
  -65533 dig -65535 dig digsum
  -65534 dig -65535 dig digsum +
  -65533 dig -65534 dig + -65535 dig digsum -
  -65535 dig 1 - / ;

: powmod -65535 bury -65534 bury -65535 dig % -65533 bury 1 -65535 dig % -65532 bury
  -65534 dig 0 > [ drop
    -65534 dig 2 % 1 = if -65532 dig -65533 dig * -65535 dig % -65532 bury then
    -65533 dig -65533 dig * -65535 dig % -65533 bury
    -65534 dig 2 / -65534 bury
    -65534 dig 0 > ] drop
  -65532 dig ;

: ndigits -65535 bury abs -65534 bury 1 -65533 bury
  -65534 dig -65535 dig / -65534 bury
  -65534 dig 0 > [ drop
    -65533 dig 1 + -65533 bury
    -65534 dig -65535 dig / -65534 bury
    -65534 dig 0 > ] drop
  -65533 dig ;

: reverse -65535 bury abs -65534 bury 0 -65533 bury
  -65534 dig 0 > [ drop
    -65533 dig -65535 dig * -65534 dig -65535 dig % + -65533 bury
    -65534 dig -65535 dig / -65534 bury
    -65534 dig 0 > ] drop
  -65533 dig ;

: smooth -65535 bury abs -65534 bury 2 -65533 bury
  -65534 dig 1 >  -65533 dig -65533 dig * -65534 dig > 0 =  * [ drop
    -65534 dig -65533 dig % 0 = if
      -65533 dig -65535 dig > if 1 -65534 bury 0 -65535 bury then
      -65534 dig -65533 dig / -65534 bury
    else
      -65533 dig 1 + -65533 bury
    then
    -65534 dig 1 >  -65533 dig -65533 dig * -65534 dig > 0 =  * ] drop
  -65534 dig -65535 dig > 0 =  -65534 dig 0 >  * ;

: nextprime 1 + dup prime 0 = [ drop 1 + dup prime 0 = ] drop ;

# totient, sigma, ndivisors and mobius use cells -65531 .. -65528, which no other word
# here touches (and none of the four calls another):
#   -65531 what is left of n, -65530 the answer so far, -65529 the trial divisor p,
#   -65528 for the p being divided out: 1 + p + p^2 + ... (sigma),
#          1 + how many times p has divided n (ndivisors)
# All four divide by p = 2, 3, 4, ... while p * p <= what is left. What is left at the end
# is 1 or a prime.

# a prime power p^k gives p^(k-1) * (p - 1): the last p divided out counts as p - 1
: totient -65531 bury 1 -65530 bury 2 -65529 bury
  -65529 dig -65529 dig * -65531 dig > 0 = [ drop
    -65531 dig -65529 dig % 0 = if
      -65531 dig -65529 dig / -65531 bury
      -65530 dig
      -65531 dig -65529 dig % 0 = if -65529 dig else -65529 dig 1 - then
      * -65530 bury
    else
      -65529 dig 1 + -65529 bury
    then
    -65529 dig -65529 dig * -65531 dig > 0 = ] drop
  -65531 dig 1 > if -65530 dig -65531 dig 1 - * -65530 bury then
  -65530 dig ;

# a prime power p^k gives 1 + p + ... + p^k
: sigma -65531 bury 1 -65530 bury 2 -65529 bury 1 -65528 bury
  -65529 dig -65529 dig * -65531 dig > 0 = [ drop
    -65531 dig -65529 dig % 0 = if
      -65531 dig -65529 dig / -65531 bury
      -65528 dig -65529 dig * 1 + -65528 bury
    else
      -65530 dig -65528 dig * -65530 bury
      1 -65528 bury
      -65529 dig 1 + -65529 bury
    then
    -65529 dig -65529 dig * -65531 dig > 0 = ] drop
  # the loop can stop with one more p left over: it belongs to the same prime power
  -65531 dig -65529 dig = if
    -65528 dig -65529 dig * 1 + -65528 bury
    1 -65531 bury
  then
  -65530 dig -65528 dig * -65530 bury
  -65531 dig 1 > if -65530 dig -65531 dig 1 + * -65530 bury then
  -65530 dig ;

# a prime power p^k has k + 1 divisors
: ndivisors -65531 bury 1 -65530 bury 2 -65529 bury 1 -65528 bury
  -65529 dig -65529 dig * -65531 dig > 0 = [ drop
    -65531 dig -65529 dig % 0 = if
      -65531 dig -65529 dig / -65531 bury
      -65528 dig 1 + -65528 bury
    else
      -65530 dig -65528 dig * -65530 bury
      1 -65528 bury
      -65529 dig 1 + -65529 bury
    then
    -65529 dig -65529 dig * -65531 dig > 0 = ] drop
  # the loop can stop with one more p left over: it belongs to the same prime power
  -65531 dig -65529 dig = if
    -65528 dig 1 + -65528 bury
    1 -65531 bury
  then
  -65530 dig -65528 dig * -65530 bury
  -65531 dig 1 > if -65530 dig 2 * -65530 bury then
  -65530 dig ;

# each prime factor flips the sign; one that divides twice makes the answer 0 and ends the loop
: mobius -65531 bury 1 -65530 bury 2 -65529 bury
  -65529 dig -65529 dig * -65531 dig > 0 = [ drop
    -65531 dig -65529 dig % 0 = if
      -65531 dig -65529 dig / -65531 bury
      -65531 dig -65529 dig % 0 = if
        0 -65530 bury
        1 -65531 bury
      else
        -65530 dig -1 * -65530 bury
      then
    else
      -65529 dig 1 + -65529 bury
    then
    -65529 dig -65529 dig * -65531 dig > 0 = ] drop
  -65531 dig 1 > if -65530 dig -1 * -65530 bury then
  -65530 dig ;
